# Use the Session Pooler connection string from Supabase Dashboard -> Connect.
# For SQLAlchemy + psycopg, use the same URI with the scheme changed to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres
DATABASE_SSLMODE=require
SUPABASE_URL=https://zbclbnhgzxnklismedlq.supabase.co
SUPABASE_PUBLISHABLE_KEY=<copy-from-supabase-dashboard-or-cli>
FRONTEND_ORIGIN=http://localhost:5173

# Optional V1 integration workflow credentials.
FABRIC_ADMIN_EMAIL=
FABRIC_ADMIN_PASSWORD=
FABRIC_LEAD_EMAIL=
FABRIC_LEAD_PASSWORD=
FABRIC_MEMBER_EMAIL=
FABRIC_MEMBER_PASSWORD=

# Gemini AI reviewer configuration.
# Keep the API key backend-only. Never put it in frontend/.env or commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000
AI_REVIEW_COOLDOWN_SECONDS=10
